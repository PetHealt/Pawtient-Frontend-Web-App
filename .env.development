# Environment: Development
# Description: Variables de entorno para pruebas locales de Pawtient
# Nota: No subir información sensible (contraseñas) aquí

# URL Base de la API Local
VITE_API_BASE_URL="http://localhost:3001"

# Endpoints del Bounded Context: IAM & Profile
VITE_USERS_ENDPOINT_PATH="/users"
VITE_CLINICS_ENDPOINT_PATH="/clinics"
VITE_PLANS_ENDPOINT_PATH="/plans"

# Endpoints del Bounded Context: Clinic
VITE_OWNERS_ENDPOINT_PATH="/owners"
VITE_PETS_ENDPOINT_PATH="/pets"
VITE_CONSULTATIONS_ENDPOINT_PATH="/consultations"

# Endpoints del Bounded Context: Appointments
VITE_APPOINTMENTS_ENDPOINT_PATH="/appointments"

# Endpoints del Bounded Context: Store
VITE_INVENTORY_ENDPOINT_PATH="/products"
VITE_SUPPLIERS_ENDPOINT_PATH="/suppliers"

# Endpoints del Bounded Context: Reports
VITE_INVOICES_ENDPOINT_PATH="/invoices"